# ── backend (port 3000) ── copy to .env and fill in real values ──

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# Auth — use a long random string (e.g. openssl rand -hex 32)
JWT_SECRET=change_this_to_a_strong_random_secret

# Server
NODE_PORT=3000

# ML Service (legacy — can leave as-is if not used)
ML_SERVICE_URL=http://localhost:8000

# Razorpay  →  https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# AI Gemini Voice Service
AI_SERVICE_URL=http://127.0.0.1:8002
