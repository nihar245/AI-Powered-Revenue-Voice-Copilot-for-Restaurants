# ── ai_service (port 8001) ── copy to .env and fill in real values ──

# Server
DEBUG=true
HOST=0.0.0.0
PORT=8001

# Deepgram (STT + TTS)  →  https://console.deepgram.com
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-2-asteria-en

# Groq (LLM)  →  https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini  →  https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Twilio  →  https://console.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
TWILIO_SIP_DOMAIN=your-sip-domain.sip.twilio.com
TWILIO_BASE_URL=https://your-ngrok-url.ngrok-free.app
